.container {
  padding: 16px 20px 40px;
  min-height: 100vh;
}

/* Summary Cards */
.summary-row {
  display: flex;
  gap: 10px;
  margin-bottom: 16px;
}
.summary-card {
  flex: 1;
  background: #1e293b;
  border-radius: 12px;
  padding: 14px 10px;
  text-align: center;
}
.summary-card.accent { background: rgba(255, 107, 53, 0.12); }
.summary-card.light { background: rgba(255, 140, 66, 0.08); }
.summary-num {
  display: block;
  font-size: 22px;
  font-weight: 900;
  color: #ffffff;
  line-height: 1;
  margin-bottom: 4px;
}
.summary-card.accent .summary-num { color: #FF6B35; }
.summary-card.light .summary-num { color: #FF8C42; }
.summary-label {
  font-size: 10px;
  color: #64748b;
}

/* Streak */
.streak-card {
  display: flex;
  align-items: center;
  background: rgba(255, 107, 53, 0.1);
  border: 1px solid rgba(255, 107, 53, 0.2);
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 20px;
}
.streak-icon { font-size: 28px; margin-right: 12px; }
.streak-info { flex: 1; }
.streak-title { display: block; font-size: 14px; font-weight: 600; color: #fff; }
.streak-desc { display: block; font-size: 11px; color: #94a3b8; margin-top: 2px; }
.streak-badge { text-align: center; }
.streak-num { display: block; font-size: 24px; font-weight: 900; color: #FF6B35; }
.streak-unit { font-size: 9px; color: #64748b; }

/* Chart */
.section-title {
  display: block;
  font-size: 12px;
  color: #94a3b8;
  margin-bottom: 12px;
  font-weight: 500;
}
.chart-section { margin-bottom: 20px; }
.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 140px;
  background: #1e293b;
  border-radius: 12px;
  padding: 16px 12px 8px;
}
.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  height: 100%;
  justify-content: flex-end;
}
.bar-value {
  font-size: 9px;
  color: #94a3b8;
  margin-bottom: 3px;
  font-weight: 600;
}
.bar {
  width: 22px;
  border-radius: 4px 4px 0 0;
  background: linear-gradient(to top, rgba(255,107,53,0.3), rgba(255,107,53,0.7));
  min-height: 4px;
  transition: height 0.3s;
}
.bar.peak {
  background: linear-gradient(to top, #FF6B35, #FF8C42);
}
.bar-label {
  font-size: 9px;
  color: #64748b;
  margin-top: 6px;
}

/* Best Records */
.best-row {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}
.best-card {
  flex: 1;
  background: #1e293b;
  border-radius: 12px;
  padding: 16px;
  text-align: center;
}
.best-num {
  display: block;
  font-size: 26px;
  font-weight: 900;
  color: #fff;
  line-height: 1;
  margin-bottom: 6px;
}
.best-num.accent { color: #FF6B35; }
.best-num.light { color: #FF8C42; }
.best-label {
  font-size: 10px;
  color: #64748b;
}

/* Monthly Goal */
.goal-card {
  background: #1e293b;
  border-radius: 12px;
  padding: 16px;
  position: relative;
}
.goal-title {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: #fff;
  margin-bottom: 2px;
}
.goal-desc {
  display: block;
  font-size: 11px;
  color: #94a3b8;
  margin-bottom: 10px;
}
.goal-bar-bg {
  height: 6px;
  background: #2a2a3e;
  border-radius: 3px;
}
.goal-bar-fill {
  height: 100%;
  background: #FF6B35;
  border-radius: 3px;
}
.goal-pct {
  position: absolute;
  right: 16px;
  top: 16px;
  font-size: 14px;
  font-weight: 700;
  color: #FF6B35;
}
