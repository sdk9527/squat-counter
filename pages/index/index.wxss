.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 24px 20px;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  justify-content: center;
  gap: 10px;
}

/* 顶部栏 */
.top-bar {
  width: 100%;
  display: flex;
  justify-content: flex-end;
  flex-shrink: 0;
  padding: 8px 0 4px;
}
.speed-badge {
  display: flex;
  align-items: center;
  gap: 3px;
  padding: 3px 8px;
  background: #1e293b;
  border-radius: 12px;
  font-size: 10px;
  color: #94a3b8;
}
.gear-icon { font-size: 10px; }

/* Progress Ring */
.ring-container {
  position: relative;
  width: 184px;
  height: 184px;
  flex-shrink: 0;
}
.ring-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.ring-inner {
  position: absolute;
  top: 15px;
  right: 15px;
  bottom: 15px;
  left: 15px;
  border-radius: 50%;
  background: #1a1a2e;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.count-number {
  font-size: 36px;
  font-weight: 900;
  color: #ffffff;
  line-height: 1;
}
.count-label {
  font-size: 11px;
  color: #94a3b8;
  margin-top: 3px;
}
.count-target {
  font-size: 10px;
  color: #FF8C42;
  margin-top: 2px;
  font-weight: 500;
}

/* Info Row */
.info-row {
  display: flex;
  gap: 10px;
  width: 100%;
  flex-shrink: 0;
}
.info-card {
  flex: 1;
  background: #1e293b;
  border-radius: 10px;
  padding: 8px 10px;
  text-align: center;
}
.info-label {
  display: block;
  font-size: 10px;
  color: #94a3b8;
}
.info-value {
  display: block;
  font-size: 16px;
  font-weight: 700;
  color: #ffffff;
}

/* Waveform */
.waveform-card {
  background: #1e293b;
  border-radius: 10px;
  padding: 8px 12px;
  width: 100%;
  flex-shrink: 0;
}
.waveform-title {
  font-size: 10px;
  color: #64748b;
  margin-bottom: 4px;
  display: block;
}
.waveform {
  display: flex;
  align-items: flex-end;
  gap: 2px;
  height: 40px;
}
.wave-bar {
  flex: 1;
  background: #334155;
  border-radius: 2px;
  transition: height 0.1s;
}
.wave-bar.active { background: #FF6B35; }
.wave-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 3px;
}
.wave-label { font-size: 8px; color: #334155; }
.wave-label.on { color: #FF6B35; }
.wave-label.off { color: #334155; }


/* Actions */
.actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}
.btn-start {
  width: 154px;
  height: 154px;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35, #FF8C42);
  color: #fff;
  font-size: 20px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 30px rgba(255, 107, 53, 0.3);
}
.btn-start:active {
  opacity: 0.8;
  transform: scale(0.95);
}

.manual-btns {
  display: flex;
  gap: 16px;
}
.btn-manual {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-manual.plus {
  background: rgba(255, 107, 53, 0.15);
  border: 2px solid #FF6B35;
}
.btn-manual.minus {
  background: rgba(100, 116, 139, 0.15);
  border: 2px solid #64748b;
}
.manual-icon {
  font-size: 20px;
  font-weight: 700;
  color: #ffffff;
}

.sensor-status {
  padding: 4px 12px;
  border-radius: 16px;
  background: #1e293b;
}
.sensor-status text { font-size: 10px; color: #64748b; }
.sensor-status.ready text { color: #FF6B35; }

.calibration-hint {
  background: rgba(255, 107, 53, 0.08);
  border-radius: 10px;
  padding: 10px 14px;
  text-align: center;
  flex-shrink: 0;
}
.calibration-hint text {
  display: block;
  font-size: 11px;
  color: #94a3b8;
}
.hint-sub {
  font-size: 9px !important;
  color: #64748b !important;
  margin-top: 2px;
}

/* 速度档位弹窗 */
.speed-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}
.speed-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #1e293b;
  border-radius: 20px 20px 0 0;
  padding: 20px 24px 40px;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s;
}
.speed-picker.show {
  transform: translateY(0);
}
.speed-picker-title {
  font-size: 15px;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 16px;
  text-align: center;
}
.speed-option {
  display: flex;
  align-items: center;
  padding: 14px 12px;
  border-radius: 12px;
  margin-bottom: 8px;
}
.speed-option.selected {
  background: rgba(255, 107, 53, 0.12);
  border: 1px solid rgba(255, 107, 53, 0.3);
}
.speed-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  border: 2px solid #64748b;
  margin-right: 14px;
  flex-shrink: 0;
}
.speed-option.selected .speed-dot {
  background: #FF6B35;
  border-color: #FF6B35;
}
.speed-info { flex: 1; }
.speed-name {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 2px;
}
.speed-desc {
  display: block;
  font-size: 11px;
  color: #64748b;
}
